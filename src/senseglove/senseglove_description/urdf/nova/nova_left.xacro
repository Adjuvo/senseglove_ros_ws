    <!-- Joints -->
    <joint name="joint_base_fixed_parent_joint" type="fixed">
        <parent link="world"/>
        <child link="l_glove_hub"/>
        <origin xyz="-0.5 0 ${hover_height}" rpy="${180*pi/180} 0 ${180*pi/180}"/>
    </joint>

